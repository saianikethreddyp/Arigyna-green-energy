# Verified Arignya WhatsApp business number in E.164 format, for example +91XXXXXXXXXX.
# Do not enable the calculator handoff until the business owner confirms this number.
ARIGNYA_WHATSAPP_E164=

# HTTPS endpoint that accepts the normalized SolarLeadPayload JSON object.
# Without this, the form returns an honest "not sent or stored" state.
SOLAR_LEAD_WEBHOOK_URL=
